{
  "name": "poortaal",
  "private": true,
  "scripts": {
    "dev": "node scripts/compile-app.mjs && concurrently --kill-others \"node scripts/compile-app.mjs --watch\" \"vite\"",
    "build": "node scripts/compile-app.mjs && vite build --base=/poortaal/",
    "preview": "vite preview --base=/poortaal/"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
